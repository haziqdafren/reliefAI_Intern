# Airtable Configuration
# Get these from: https://airtable.com/account
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_airtable_base_id_here
AIRTABLE_NEWSLETTER_TABLE=Newsletter
AIRTABLE_INQUIRIES_TABLE=Inquiries
AIRTABLE_PAYMENTS_TABLE=Payments
AIRTABLE_SHIPMENTS_TABLE=Shipments

# Stripe Configuration
# TEST MODE: Get from https://dashboard.stripe.com/test/apikeys (toggle to Test mode)
# LIVE MODE: Get from https://dashboard.stripe.com/apikeys (toggle to Live mode)
#
# For testing: Use sk_test_..., pk_test_..., price_test_...
# For production: Use sk_live_..., pk_live_..., price_live_...

# Backend Keys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Frontend Keys (must start with REACT_APP_)
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
REACT_APP_STRIPE_JOURNAL_PRICE_ID=price_your_journal_price_id_here

# IMPORTANT: When switching to LIVE mode:
# 1. Replace all keys with sk_live_..., pk_live_..., price_live_...
# 2. Create new webhook at https://dashboard.stripe.com/webhooks (LIVE mode)
# 3. Webhook URL: https://jessieli.co/api/stripe-webhook
# 4. Select event: checkout.session.completed
# 5. Update STRIPE_WEBHOOK_SECRET with new signing secret

# Google Analytics 4
# Current Measurement ID: G-EG1FN3E7EZ (already configured in code)
# Get this from: https://analytics.google.com/
REACT_APP_GA_MEASUREMENT_ID=G-EG1FN3E7EZ

# Site URL (Optional - used for Stripe redirects)
# Leave empty to auto-detect from request headers
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Resend Email Service
# Get this from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
